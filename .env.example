# Environment Configuration
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/votedine?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
# Required in production: a secret of at least 32 characters. Generate one with:
#   openssl rand -hex 32
# Left empty on purpose so that copying this file cannot ship a usable key.
JWT_SECRET=""

# API Keys
YELP_API_KEY="your-yelp-api-key"
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Server Configuration
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# Used only by the GitHub Pages static export; do not put API keys here.
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_BASE_PATH=/VoteDine
